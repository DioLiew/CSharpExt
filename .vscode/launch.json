{
   "version": "0.2.0",
   "configurations": [
      {
         "name": "SPV.Blazor Runner",
         "type": "coreclr",
         "request": "launch",
         //"preLaunchTask": "Build.SPV.Blazor",
         //"program": "E:\\Box\\NET 10\\Web APP\\SPV.Blazor\\SPV.Blazor\\bin\\Debug\\net10.0\\SPV.Blazor.dll",
         "program": "${workspaceFolder}/SPV.Blazor/bin/Debug/net10.0/SPV.Blazor.dll",
         "cwd": "${workspaceFolder}/SPV.Blazor",
         "stopAtEntry": false,
         "logging": {
            "moduleLoad": false
         },
         "env": {
            "ASPNETCORE_ENVIRONMENT": "Development",
            "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
         },
         // "serverReadyAction": {
         //    "action": "openExternally",
         //    "pattern": "\\bNow listening on:\\s+http://\\S+:([0-9]+)",
         //    "uriFormat": "http://localhost:%s"
         // },
         "presentation": {
            "hidden": false,
            "group": "Blazor",
            "order": 0
         }
      },
      {
         "name": "SPV.Blazor Watcher",
         "type": "coreclr",
         "request": "launch",
         //"preLaunchTask": "Build.SPV.Blazor",
         "program": "dotnet",
         "args": [
            "watch",
            "--project",
            ".",
            "--non-interactive"
         ],
         "cwd": "${workspaceFolder}/SPV.Blazor",
         // "stopAtEntry": false,
         "logging": {
            "moduleLoad": false
         },
         "env": {
            "ASPNETCORE_ENVIRONMENT": "Development",
            "DOTNET_WATCH_RESTART_ON_RUDE_EDIT": "true"
         },
         // "serverReadyAction": {
         //    "action": "openExternally",
         //    "pattern": "\\bNow listening on:\\s+http://\\S+:([0-9]+)",
         //    "uriFormat": "http://localhost:%s"
         // },
         "presentation": {
            "hidden": false,
            "group": "Blazor",
            "order": 1
         }
      },
      {
         "name": "SPV.Blazor Debugger",
         "type": "coreclr",
         "request": "attach",
         //"processId": "${command:pickProcess}", // Use this to look into what is the processName
         "processName": "SPV.Blazor.exe",
         //"processPath": "E:\\Box\\Visual Studio\\Net 10\\Web App\\SPV\\SPV.Blazor\\bin\\Debug\\net10.0\\SPV.Blazor.exe",
         "presentation": {
            "hidden": false,
            "group": "Blazor",
            "order": 2
         }
      },
      {
         "name": "SPV.Blazor App",
         "type": "chrome",
         "request": "launch",
         //"preLaunchTask": "Delay.Launch",
         "url": "http://localhost:5110",
         "webRoot": "${workspaceFolder}/SPV.Blazor",
         "timeout": 60000,
         "presentation": {
            "hidden": false,
            "group": "Blazor",
            "order": 3
